{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Judicore Legal Database Builder",
  "version": "0.1.0",
  "identifier": "in.judicore.legal-database-builder",
  "build": {
    "beforeDevCommand": "pnpm.cmd --dir ../frontend dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm.cmd --dir ../frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Judicore Legal Database Builder",
        "width": 1440,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8765; connect-src 'self' http://127.0.0.1:8765; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    },
    "resources": ["resources/backend/*"]
  },
  "plugins": {}
}
