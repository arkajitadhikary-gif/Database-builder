# Backend runtime
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8765

# PostgreSQL is the canonical store; use a separate database for integration tests.
DATABASE_URL=postgresql+psycopg://judicore:judicore@127.0.0.1:5432/judicore
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=1800

# Reference and optional managed archive storage
REFERENCE_ROOT=./storage/reference
ARCHIVE_ROOT=./storage/archive
MANAGED_ARCHIVE_ENABLED=false

# Bounded pipeline settings
MAX_EXTRACTION_WORKERS=2
MAX_DISCOVERED_FILES=100000
MAX_PDF_BYTES=524288000
MAX_OCR_WORKERS=1
DB_BATCH_SIZE=100
EMBEDDING_BATCH_SIZE=32

# OCR and embeddings
OCR_ENABLED=true
OCR_TIMEOUT_SECONDS=180
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# AI verification is opt-in. Local NIM is the privacy-safe default; hosted
# NVIDIA endpoints require explicit consent and AI_NIM_HOSTED_ALLOWED=true.
AI_VERIFICATION_ENABLED=false
AI_VERIFICATION_PROVIDER=nvidia_nim
AI_VERIFICATION_MODEL=nvidia/nemotron-mini-4b-instruct
AI_NIM_BASE_URL=http://127.0.0.1:8000/v1
AI_NIM_API_KEY=
AI_NIM_HOSTED_ALLOWED=false
# Optional bearer token for read-only OpenAPI/MCP AI access.
AI_READ_TOKEN=

# Optional per-process localhost token. Do not commit a real value.
SESSION_TOKEN=
LOG_LEVEL=INFO
